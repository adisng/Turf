# Public Supabase configuration used by the browser and server clients.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-anon-key

# Optional local development redirect. In production, the app URL is used.
NEXT_PUBLIC_DEV_SUPABASE_REDIRECT_URL=http://localhost:3000/auth/callback

# Add the real facility values before handover. Do not commit .env.local.
# NEXT_PUBLIC_CONTACT_ADDRESS=
# NEXT_PUBLIC_CONTACT_PHONE=
# NEXT_PUBLIC_CONTACT_EMAIL=

# Server-only Google Sheets marketing mirror. Leave both unset to keep contacts in Supabase only.
# Create a Google service account, share the target Sheet with its service-account email, then paste its full JSON key on one line.
# GOOGLE_SHEETS_MARKETING_SHEET_ID=
# GOOGLE_SHEETS_SERVICE_ACCOUNT_JSON={"type":"service_account"}
# GOOGLE_SHEETS_MARKETING_TAB=Marketing contacts
