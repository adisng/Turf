# Copy this file to .env.local and fill in real values.
# Never commit .env.local or real secrets to version control.

# Supabase public runtime configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_DEV_SUPABASE_REDIRECT_URL=

# Application URL used in deployment and email links
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Razorpay test mode (server-only; never expose these to the browser)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
